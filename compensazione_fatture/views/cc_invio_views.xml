<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cc_invio_list" model="ir.ui.view">
        <field name="name">cc.invio.list</field>
        <field name="model">cc.invio</field>
        <field name="arch" type="xml">
            <tree string="Invoices to offset"
                  editable="bottom"
                  decoration-success="state=='inviata'"
                  decoration-danger="state=='errore'"
                  decoration-muted="state=='da_inviare'">
                <header>
                    <button name="action_invia" type="object"
                            string="Send to Nexyzen"
                            class="btn-primary"/>
                </header>
                <field name="move_id" readonly="1"/>
                <field name="tipo" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="numero_fattura" readonly="1"/>
                <field name="data_scadenza" readonly="1"/>
                <field name="importo_residuo"
                       readonly="state != 'da_inviare'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" readonly="1"
                       decoration-success="state=='inviata'"
                       decoration-danger="state=='errore'"/>
                <field name="data_invio" readonly="1"/>
                <field name="messaggio" readonly="1" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_cc_invio_form" model="ir.ui.view">
        <field name="name">cc.invio.form</field>
        <field name="model">cc.invio</field>
        <field name="arch" type="xml">
            <form string="Invoice to offset">
                <header>
                    <button name="action_invia" type="object"
                            string="Send to Nexyzen"
                            class="btn-primary"
                            invisible="state == 'inviata'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="da_inviare,inviata"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="move_id"/>
                            <field name="tipo"/>
                            <field name="partner_id"/>
                            <field name="numero_fattura"/>
                        </group>
                        <group>
                            <field name="data_scadenza"/>
                            <field name="importo_residuo"
                                   readonly="state != 'da_inviare'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="data_invio"/>
                        </group>
                    </group>
                    <group string="Result">
                        <field name="messaggio" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cc_invio_search" model="ir.ui.view">
        <field name="name">cc.invio.search</field>
        <field name="model">cc.invio</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="partner_id"/>
                <filter name="da_inviare" string="To send"
                        domain="[('state','=','da_inviare')]"/>
                <filter name="inviate" string="Sent"
                        domain="[('state','=','inviata')]"/>
                <filter name="errore" string="In error"
                        domain="[('state','=','errore')]"/>
                <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer/Vendor"
                        context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_cc_invio" model="ir.actions.act_window">
        <field name="name">Invoices to offset</field>
        <field name="res_model">cc.invio</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_da_inviare': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No invoices to offset
            </p>
            <p>
                The unpaid invoices to offset appear here after the cycle runs, automatically or from the Settings.
            </p>
        </field>
    </record>
</odoo>
