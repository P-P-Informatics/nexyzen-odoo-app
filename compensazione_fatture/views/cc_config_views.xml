<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cc_config_form" model="ir.ui.view">
        <field name="name">cc.config.form</field>
        <field name="model">cc.config</field>
        <field name="arch" type="xml">
            <form string="Nexyzen Settings">
                <header>
                    <button name="action_test_connessione" type="object"
                            string="Test connection" class="btn-secondary"/>
                    <button name="action_esegui_adesso" type="object"
                            string="Select and send now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <img src="/compensazione_fatture/static/description/logo.png"
                             alt="Nexyzen" style="max-height:52px; margin-bottom:8px;"/>
                        <p>Send your unpaid invoices to Nexyzen to offset them.</p>
                    </div>
                    <notebook>
                        <page string="Selection criteria">
                            <group>
                                <group string="Which invoices">
                                    <field name="invia_vendite"/>
                                    <field name="invia_acquisti"/>
                                </group>
                                <group string="Due date (days from today)">
                                    <field name="giorni_min"/>
                                    <field name="giorni_max"/>
                                </group>
                                <group string="Amount range (residual)">
                                    <field name="importo_min"/>
                                    <field name="importo_max"/>
                                </group>
                            </group>
                            <group string="Limit to customers/vendors (optional)">
                                <field name="partner_ids" nolabel="1"
                                       widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Sending">
                            <group>
                                <group string="Mode">
                                    <field name="modalita" widget="radio"/>
                                </group>
                                <group string="Sending days">
                                    <field name="giorno_lun"/>
                                    <field name="giorno_mar"/>
                                    <field name="giorno_mer"/>
                                    <field name="giorno_gio"/>
                                    <field name="giorno_ven"/>
                                    <field name="giorno_sab"/>
                                </group>
                            </group>
                        </page>
                        <page string="Connection">
                            <group>
                                <field name="api_url"/>
                                <field name="cod_affiliato"/>
                                <field name="token" password="True"/>
                                <field name="email_proponente"/>
                                <field name="cellulare_proponente"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cc_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">cc.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_cc_config_open" model="ir.actions.server">
        <field name="name">Nexyzen Settings</field>
        <field name="model_id" ref="model_cc_config"/>
        <field name="state">code</field>
        <field name="code">action = model.get_config().action_apri_form()</field>
    </record>
</odoo>
